# Email (Resend) — already wired
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
FROM_EMAIL="NURVICA <onboarding@resend.dev>"
SITE_URL=http://localhost:3000

# Supabase — auto-provisioned by the Vercel Marketplace integration.
# Pull locally with: vercel env pull .env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres direct connection (used by the supabase CLI for migrations)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# AI Gateway (Vercel) — used for embeddings + Claude chat
# Set via Vercel AI Gateway dashboard; passed via OIDC in deployed envs.
AI_GATEWAY_API_KEY=
